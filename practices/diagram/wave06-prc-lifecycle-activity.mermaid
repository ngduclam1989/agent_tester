flowchart TD
    Start([Bắt đầu]) --> A1[Mở màn Danh sách tính giá xuất kho - PRC-LIST]
    A1 --> D1{Chọn thao tác}
    D1 -->|Xem 1 dòng| B1[Điều hướng sang PRC-DETAIL]
    D1 -->|Tính giá mới| C1[Mở form PRC-CREATE]
    D1 -->|Xóa 1 dòng| E1[Mở dialog xác nhận xóa - PRC-DELETE]

    subgraph CREATE[PRC-CREATE]
    C1 --> C2[Chọn Kỳ kế toán - auto-fill Từ ngày/Đến ngày, khóa sửa]
    C2 --> C3[Chọn Kho + Phương pháp tính giá]
    C3 --> C4{Phạm vi mã}
    C4 -->|Tất cả mã| C5[Không đổ bảng - server tự resolve khi submit]
    C4 -->|Chọn mã cụ thể| C6[Thêm dòng qua nút Thêm phụ tùng]
    C6 --> C7[Chọn mã từ dropdown - chỉ mã BQGQ Đang hoạt động]
    C5 --> C8[Bấm Thực hiện tính giá]
    C7 --> C8
    C8 --> C9{Validate BE}
    C9 -->|Kỳ đã đóng - ERR-INV-024| C10[Inline error - giữ nguyên form]
    C10 --> C8
    C9 -->|Đang có job chạy - ERR-INV-029| C11[Dialog chặn - giữ nguyên form]
    C11 --> C8
    C9 -->|Hợp lệ| C12[202 Accepted - tạo log trạng thái Đang tính]
    C12 --> C13[Redirect sang PRC-DETAIL của run mới]
    end

    subgraph DETAIL[PRC-DETAIL]
    C13 --> DT1[Poll mỗi 5 giây khi Đang tính]
    B1 --> DT1
    DT1 --> DT2{Trạng thái cuối}
    DT2 -->|Thành công| DT3[Hiển thị Thành công - giá vốn và sổ tồn đã cập nhật]
    DT2 -->|Hoàn thành có lỗi| DT4[Hiển thị mã lỗi kèm lý do]
    DT4 --> D2{Chạy lại?}
    D2 -->|Tính lại toàn bộ| R1[RECALC phạm vi ALL]
    D2 -->|Tính lại mã lỗi| R2[RECALC phạm vi ERROR_ONLY - chỉ hiện khi có mã lỗi]
    D2 -->|Không| EndDetail1([Kết thúc xem])
    DT3 --> D3{Có kỳ sau bị ảnh hưởng?}
    D3 -->|Có| W1[Toast cảnh báo - liệt kê kỳ sau cần tính lại]
    D3 -->|Không| EndDetail2([Kết thúc])
    end

    subgraph RECALC[PRC-RECALC - 2 nút trên PageHeader của DETAIL]
    R1 --> RC1{Validate BE}
    R2 --> RC1
    RC1 -->|Kỳ đóng - ERR-INV-024| RC2[Dialog cảnh báo]
    RC1 -->|Đang chạy - ERR-INV-029| RC3[Dialog chặn]
    RC1 -->|Hợp lệ| RC4[202 - tạo run mới, source_run_id trỏ về run gốc]
    RC4 --> DT1
    end

    subgraph DELETE[PRC-DELETE - modal trên PRC-LIST]
    E1 --> DL1{Người dùng chọn}
    DL1 -->|Hủy hoặc Escape| DL2[Đóng dialog - không xóa]
    DL1 -->|Xác nhận xoá| DL3{Validate BE}
    DL3 -->|Kỳ đóng - ERR-INV-024| DL4[Swap nội dung dialog - Không thể xóa]
    DL3 -->|Đang tính - ERR-INV-029| DL5[Swap nội dung dialog - Không thể xóa]
    DL3 -->|Hợp lệ| DL6[Soft-delete - KHÔNG rollback giá vốn đã cập nhật]
    DL6 --> DL7[Toast thành công + refetch danh sách]
    end

    DL7 --> A1
    DL2 --> A1
    EndDetail1 --> A1
