{
  "name": "garage-e2e-playwright-harness",
  "version": "1.0.0",
  "description": "QC-owned Playwright harness for Garage E2E journeys",
  "scripts": {
    "test": "playwright test -c playwright.config.ts",
    "test:smoke": "playwright test -c playwright.config.ts --project=probe smoke.spec.ts",
    "install-browsers": "npx playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
