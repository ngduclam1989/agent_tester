# Garage API test harness — environment template
# Copy to .env (gitignored) and populate from infra/.env / infra/.env.bff
# Reference memory: bff-env-dual-layer, garage-jwt-no-signature-verify

# === Service base URLs (Docker/dev defaults) ===
GF_SALES_BASE_URL=http://localhost:45091
GF_ACCOUNTING_BASE_URL=http://localhost:45081
GF_SYSTEM_BASE_URL=http://localhost:45193
AGG_GARAGE_GRAPH_URL=http://localhost:45401/garage/graphql
# NOTE: BFF endpoint path = ${CONTEXT_PATH}${GRAPHQL_PUBLIC_PATH} per agg-garage-graph ENV.
# Default: /garage + /graphql = /garage/graphql. See TL-W02-API-001 / TL-W02-SEC-001.

# === Internal API key (gf-sales protected/v1/* + service-to-service) ===
# Source: infra/.env → GF_INTERNAL_API_KEY (default fallback "internal-dev-key-local")
# Required for: GET /protected/v1/service-orders/{tenantId}/{code}/for-print
# See BUG-W02-045 + TL-W02-API-005 for harness mismatch root cause.
GF_INTERNAL_API_KEY=internal-dev-key-local

# === Tenant matrix ===
TENANT_A_ID=1
TENANT_B_ID=467

# === Auth tokens (sso-stub HS256 mint — signature not verified backend) ===
# Reference memory: garage-jwt-no-signature-verify
ACCOUNTANT_TOKEN=
OWNER_TOKEN=
TECH_TOKEN=
INVALID_TOKEN=tampered.signature.payload
EXPIRED_TOKEN=

# === Test data seeds (W02 — populate after seed script) ===
# Reference: TL-W02-E2E-003 (seed depletion — SO BH COMPLETED missing)
SEED_SO_BH_COMPLETED_CODE=PDV-20260622-00009
SEED_SO_NO_BH_COMPLETED_CODE=PDV-20260619-00004
SEED_STL_BH_CODE=SET-20260622-00005
SEED_STL_BH_DOSSIER_CODE=SET-20260622-00002

# === Optional: Playwright base URLs (for E2E that probes BFF/API in flight) ===
WEB_BASE_URL=http://localhost:45300
PLAYWRIGHT_BASE_URL=http://localhost:45300
