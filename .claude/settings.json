{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check_destructive_bash.sh",
            "timeout": 10,
            "statusMessage": "Kiểm tra lệnh có khả năng phá hủy dữ liệu (RULE_GLOBAL.md)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cleanup_temp_files.sh",
            "timeout": 30,
            "statusMessage": "Dọn dẹp file tạm/debug (RULE_GLOBAL.md)..."
          }
        ]
      }
    ]
  }
}
