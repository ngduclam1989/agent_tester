# Copy file này thành .env và điền giá trị thật. KHÔNG commit .env vào repo.
API_BASE_URL=https://testek.vn/lab/api/v0/prod-man
API_LOGIN_PATH=/login-with-local
API_USERNAME=
API_PASSWORD=
API_LANG=VN

# --- API AML Transaction Screening (MSB) ---
# Base URL SIT lấy từ bộ TC_AML_TRANSACTION_SCREENING_API 5. Đổi khi chạy môi trường khác.
AML_BASE_URL=https://10.0.137.75:7001
# Cách 1 (khuyến nghị): khai user/pass, code tự dựng chuỗi Basic.
AML_USERNAME=
AML_PASSWORD=
# Cách 2: dán thẳng giá trị header nếu chỉ có chuỗi base64. Có giá trị thì ghi đè cách 1.
# AML_AUTH_HEADER=Basic xxxxxxxxxxxx
