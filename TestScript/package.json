{
  "name": "agent-tester",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "rimraf test-results allure-results allure-report",
    "test": "npx playwright test",
    "test:api": "npx playwright test --project=api",
    "test:aml": "npx playwright test --project=api tests/api/aml-transaction-screening.spec.ts",
    "test:api:ui": "npx playwright test --project=api --ui",
    "test:api:allure": "npx playwright test --project=api --reporter=line,allure-playwright",
    "test:web": "npx playwright test --project=web --headed",
    "test:db": "npx playwright test --project=db",
    "sample:excel": "tsx scripts/create-sample-excel.ts",
    "typecheck": "tsc --noEmit",
    "report": "npx monocart show-report test-results/report.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/oracledb": "^7.0.3",
    "allure-playwright": "^3.7.1",
    "dotenv": "^17.2.3",
    "monocart-reporter": "^2.10.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oracledb": "^7.0.1",
    "xlsx": "^0.18.5"
  }
}
